---
import BaseHead from '../components/BaseHead.astro';
import type { Alternate } from '../components/BaseHead.astro';
import { NAV, SOCIALS, siteText } from '../site.config';
import { alternateLocaleUrl, localePath, localeUrl } from '../utils';
import { HTML_LANG, LOCALE_LABEL, LOCALES, useTranslations, type Locale } from '../i18n';
import '../styles/global.css';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  /** 覆盖默认的 hreflang 列表（项目详情页只链有翻译的版本） */
  alternates?: Alternate[];
  /** 覆盖语言切换器的目标地址 */
  switchHrefs?: Partial<Record<Locale, string>>;
}

const { locale, title, description, alternates, switchHrefs } = Astro.props;

const t = useTranslations(locale);
const site = siteText(locale);

/** 去掉 base，得到站内路径 */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = (base && Astro.url.pathname.startsWith(base)
  ? Astro.url.pathname.slice(base.length)
  : Astro.url.pathname) || '/';

/** 导航高亮：把语言前缀算进去再比；首页只认完全相等，否则 /zh/ 会吃掉所有中文页 */
const isCurrent = (href: string) => {
  const target = localePath(locale, href).replace(/\/+$/, '') || '/';
  const current = currentPath.replace(/\/+$/, '') || '/';
  if (href === '/') return current === target;
  return current === target || current.startsWith(`${target}/`);
};

/** 语言切换器的目标地址 */
const switchUrl = (target: Locale) =>
  switchHrefs?.[target] ?? alternateLocaleUrl(Astro.url.pathname, target);

/** 默认 hreflang：两种语言的同一页面 + x-default 指向默认语言 */
const headAlternates: Alternate[] =
  alternates ??
  [
    ...LOCALES.map((l) => ({
      hreflang: HTML_LANG[l],
      href: new URL(switchUrl(l), Astro.site ?? Astro.url.origin).href,
    })),
    {
      hreflang: 'x-default',
      href: new URL(switchUrl('en'), Astro.site ?? Astro.url.origin).href,
    },
  ];

const year = new Date().getFullYear();
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <BaseHead locale={locale} title={title} description={description} alternates={headAlternates} />
  </head>
  <body>
    <!-- 背景层：顶部柔光 + 斜向飘带曲线。纯 SVG，无图片请求 -->
    <div class="bg-layer" aria-hidden="true">
      <svg class="bg-ribbons" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" fill="none">
        <defs>
          <linearGradient id="ribbon-fade" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-opacity="0"></stop>
            <stop offset="0.28" stop-opacity="1"></stop>
            <stop offset="0.72" stop-opacity="1"></stop>
            <stop offset="1" stop-opacity="0"></stop>
          </linearGradient>
        </defs>
        <path
          class="ribbon ribbon-1"
          d="M -140 140 C 220 40, 520 320, 840 190 S 1300 20, 1620 170"
          stroke="url(#ribbon-fade)"
          stroke-width="20"
        ></path>
        <path
          class="ribbon ribbon-2"
          d="M -140 420 C 200 320, 560 620, 880 460 S 1320 290, 1620 430"
          stroke="url(#ribbon-fade)"
          stroke-width="13"
        ></path>
        <path
          class="ribbon ribbon-3"
          d="M -140 710 C 240 630, 600 870, 940 700 S 1340 530, 1620 680"
          stroke="url(#ribbon-fade)"
          stroke-width="8"
        ></path>
      </svg>
    </div>

    <div class="site">
      <header class="site-header">
        <div class="wrap">
          <a class="brand" href={localeUrl(locale, '/')}>{site.title}</a>

          <div class="header-end">
            <nav class="site-nav" aria-label={t('nav.aria')}>
              {
                NAV.map((item) => (
                  <a
                    href={localeUrl(locale, item.href)}
                    aria-current={isCurrent(item.href) ? 'page' : undefined}
                  >
                    {t(`nav.${item.key}`)}
                  </a>
                ))
              }
            </nav>

            <div class="lang-switch" role="group" aria-label={t('lang.switchAria')}>
              {
                LOCALES.map((l, i) => (
                  <>
                    {i > 0 && <span class="sep" aria-hidden="true">/</span>}
                    <a
                      href={switchUrl(l)}
                      hreflang={HTML_LANG[l]}
                      lang={HTML_LANG[l]}
                      aria-current={l === locale ? 'true' : undefined}
                    >
                      {LOCALE_LABEL[l]}
                    </a>
                  </>
                ))
              }
            </div>
          </div>
        </div>
      </header>

      <main id="main">
        <div class="wrap">
          <slot />
        </div>
      </main>

      <footer class="site-footer">
        <div class="wrap">
          <span>© {year} {site.author}</span>
          {
            SOCIALS.length > 0 && (
              <div class="footer-links">
                {SOCIALS.map((s) => (
                  <a href={s.href} target="_blank" rel="noopener noreferrer">
                    {s.label}
                  </a>
                ))}
              </div>
            )
          }
        </div>
      </footer>
    </div>

    <script>
      // 滚动渐显：首屏以外的区块进入视口时上浮淡入，只播放一次。
      // .reveal 在运行时才加，所以没有 JS 时内容照常显示。
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = document.querySelectorAll(
        'main .wrap > section:not(.hero):not(.statement-section), main .wrap > header, main .wrap > article, main .wrap > ul.timeline',
      );

      if (!prefersReduced && 'IntersectionObserver' in window && targets.length > 0) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.08 },
        );

        targets.forEach((el) => {
          el.classList.add('reveal');
          observer.observe(el);
        });
      }

      // 大字段落：整块进入视口时，按阅读顺序逐词点亮。
      // 不做滚动触发，因为内容少时整页常常一屏放得下、根本没有滚动空间。
      const words = Array.from(document.querySelectorAll<HTMLElement>('.statement-word'));
      const statementSection = document.querySelector('.statement-section');

      if (!prefersReduced && statementSection && words.length > 0) {
        // 词少时慢一点、词多时快一点，总时长封顶 800ms
        const step = Math.min(140, 800 / words.length);

        const observer = new IntersectionObserver(
          (entries) => {
            if (!entries.some((entry) => entry.isIntersecting)) return;
            observer.disconnect();
            words.forEach((word, i) => {
              window.setTimeout(() => word.classList.add('is-lit'), i * step);
            });
          },
          { threshold: 0.35 },
        );

        observer.observe(statementSection);
      }
    </script>
  </body>
</html>
