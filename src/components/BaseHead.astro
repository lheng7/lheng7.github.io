---
/**
 * 小小的 SEO 组件：标题、描述、canonical、hreflang、Open Graph。
 * 不引任何外部依赖，避免免费站被第三方脚本拖慢。
 */
import { siteText } from '../site.config';
import { OG_LOCALE, type Locale } from '../i18n';

export interface Alternate {
  hreflang: string;
  href: string;
}

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  /** 各语言版本的地址，渲染成 <link rel="alternate" hreflang> */
  alternates?: Alternate[];
}

const { locale, title, description, alternates = [] } = Astro.props;
const site = siteText(locale);

const pageTitle = title ? `${title} · ${site.title}` : `${site.title} · ${site.tagline}`;
const pageDescription = description ?? site.description;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const favicon = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.png`;
---

<title>{pageTitle}</title>
<meta name="description" content={pageDescription} />
<link rel="canonical" href={canonical.href} />
<link rel="icon" type="image/png" href={favicon} />
<link rel="apple-touch-icon" href={favicon} />

{alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}

<meta property="og:type" content="website" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={pageDescription} />
<meta property="og:url" content={canonical.href} />
<meta property="og:site_name" content={site.title} />
<meta property="og:locale" content={OG_LOCALE[locale]} />

<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />

<meta name="generator" content={Astro.generator} />
