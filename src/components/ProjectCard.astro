---
import { formatRange, localeUrl } from '../utils';
import type { Locale } from '../i18n';
import { projectSlug, type Project } from '../lib/projects';

interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
const { title, summary, startDate, endDate, tags } = project.data;
const href = localeUrl(locale, `/projects/${projectSlug(project.id)}/`);
const shownTags = tags.slice(0, 3);
---

<a class="card" href={href}>
  <h3 class="card-title">{title}</h3>
  <p class="card-summary">{summary}</p>
  <div class="card-meta">
    <span>{formatRange(startDate, endDate, locale)}</span>
    {
      shownTags.length > 0 && (
        <div class="card-tags">
          {shownTags.map((tag) => (
            <span>{tag}</span>
          ))}
        </div>
      )
    }
  </div>
</a>
