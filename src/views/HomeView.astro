---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { siteText } from '../site.config';
import { localeUrl } from '../utils';
import { useTranslations, type Locale } from '../i18n';
import { getProjects } from '../lib/projects';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const site = siteText(locale);

const projects = await getProjects(locale);

/** 大字段落逐词点亮：英文按词拆并用空格连接，中文按字拆、不插空格 */
const statement = t('home.statement');
const escapeHtml = (text: string) =>
  text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const statementWords = locale === 'zh' ? Array.from(statement) : statement.split(/\s+/);
const statementHtml = statementWords
  .map((word) => `<span class="statement-word">${escapeHtml(word)}</span>`)
  .join(locale === 'zh' ? '' : ' ');
const featured = projects.filter((p) => p.data.featured).slice(0, 4);
const shown = featured.length > 0 ? featured : projects.slice(0, 6);
---

<BaseLayout locale={locale}>
  <section class="hero">
    <h1>{site.title}</h1>
    <p class="lede">{site.description}</p>
  </section>

  <section>
    <div class="section-head">
      <h2>{featured.length > 0 ? t('home.featured') : t('home.projects')}</h2>
      <a class="more" href={localeUrl(locale, '/projects/')}>{t('home.allProjects')}</a>
    </div>

    {
      shown.length > 0 ? (
        <div class="card-grid">
          {shown.map((project) => (
            <ProjectCard project={project} locale={locale} />
          ))}
        </div>
      ) : (
        <div class="empty">
          <p>{t('home.emptyTitle')}</p>
          <p class="small">{t('home.emptyHint')}</p>
        </div>
      )
    }
  </section>

  <section class="statement-section">
    <p class="statement" set:html={statementHtml} />
  </section>
</BaseLayout>
