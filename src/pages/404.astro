---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../utils';
---

<BaseLayout title="页面不存在" description="没有找到这个页面。">
  <header class="page-head">
    <h1>404</h1>
    <p>没有找到这个页面。可能是链接写错了，或者内容已经挪走了。</p>
  </header>

  <p><a class="btn" href={url('/')}>回到首页</a></p>
</BaseLayout>
